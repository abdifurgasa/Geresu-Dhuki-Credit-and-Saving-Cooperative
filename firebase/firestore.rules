rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return signedIn() ? userDoc().data.role : null;
    }

    function isAdmin() {
      return role() == "admin";
    }

    function isMember() {
      return role() == "member";
    }

    /* =========================
       USERS
    ========================= */
    match /users/{uid} {

      allow read: if signedIn();

      allow write: if isAdmin();
    }

    /* =========================
       MEMBERS DATA (ADMIN ONLY)
    ========================= */
    match /members/{id} {

      allow read, write: if isAdmin();
    }

    /* =========================
       SAVINGS (IMPORTANT)
       - admin sees all
       - member sees ONLY own data
    ========================= */
    match /savings/{id} {

      allow read: if isAdmin() ||
        (isMember() && resource.data.uid == request.auth.uid);

      allow write: if isAdmin() ||
        (isMember() && request.resource.data.uid == request.auth.uid);
    }

    /* =========================
       LOANS
    ========================= */
    match /loans/{id} {

      allow read: if isAdmin() ||
        (isMember() && resource.data.uid == request.auth.uid);

      allow write: if isAdmin();
    }

    /* =========================
       TRANSACTIONS
    ========================= */
    match /transactions/{id} {

      allow read: if isAdmin() ||
        (isMember() && resource.data.uid == request.auth.uid);

      allow write: if isAdmin();
    }

    /* =========================
       REPORTS (ADMIN ONLY)
    ========================= */
    match /reports/{id} {

      allow read, write: if isAdmin();
    }

    /* =========================
       STATS (DASHBOARD)
    ========================= */
    match /stats/{id} {

      allow read: if signedIn();

      allow write: if isAdmin();
    }
  }
}
