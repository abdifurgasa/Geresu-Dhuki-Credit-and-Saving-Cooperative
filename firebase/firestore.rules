rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    /* =========================
       USERS (SAFE READ FIRST)
    ========================= */
    match /users/{userId} {

      allow read: if signedIn();

      allow write: if signedIn() && request.auth.uid == userId;
    }

    /* =========================
       SAFE ROLE CHECK (NO CRASH)
    ========================= */
    function getRole() {

      let userDoc =
        get(/databases/$(database)/documents/users/$(request.auth.uid));

      return userDoc.data.role;
    }

    function isAdmin() {
      return signedIn() && getRole() == "admin";
    }

    function isTeller() {
      return signedIn() && getRole() == "teller";
    }

    function isAuditor() {
      return signedIn() && getRole() == "auditor";
    }

    /* =========================
       MEMBERS
    ========================= */
    match /members/{id} {

      allow read: if signedIn();

      allow write: if isAdmin() || isTeller();
    }

    /* =========================
       SAVINGS
    ========================= */
    match /savings/{id} {

      allow read: if signedIn();

      allow write: if isAdmin() || isTeller();
    }

    /* =========================
       LOANS
    ========================= */
    match /loans/{id} {

      allow read: if signedIn();

      allow write: if isAdmin();
    }

    /* =========================
       TRANSACTIONS
    ========================= */
    match /transactions/{id} {

      allow read: if signedIn();

      allow write: if isAdmin() || isTeller();
    }

    /* =========================
       REPORTS
    ========================= */
    match /reports/{id} {

      allow read: if signedIn();

      allow write: if isAdmin();
    }
  }
}
