rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    /* =========================
       HELPERS
    ========================= */

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isSignedIn() && role() == "admin";
    }

    function isTeller() {
      return isSignedIn() && role() == "teller";
    }

    function isAuditor() {
      return isSignedIn() && role() == "auditor";
    }

    /* =========================
       USERS COLLECTION
    ========================= */
    match /users/{userId} {

      allow read: if isSignedIn();

      allow create: if isAdmin();

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    /* =========================
       MEMBERS
    ========================= */
    match /members/{id} {

      allow read: if isSignedIn();

      allow create: if isAdmin() || isTeller();

      allow update: if isAdmin() || isTeller();

      allow delete: if isAdmin();
    }

    /* =========================
       SAVINGS (DEPOSITS)
    ========================= */
    match /savings/{id} {

      allow read: if isSignedIn();

      allow create: if isAdmin() || isTeller();

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    /* =========================
       LOANS
    ========================= */
    match /loans/{id} {

      allow read: if isSignedIn();

      allow create: if isAdmin();

      allow update: if isAdmin() || isTeller();

      allow delete: if isAdmin();
    }

    /* =========================
       TRANSACTIONS
    ========================= */
    match /transactions/{id} {

      allow read: if isSignedIn();

      allow create: if isAdmin() || isTeller();

      allow update: if false;  // NO editing history (audit-safe)

      allow delete: if isAdmin();
    }

    /* =========================
       REPORTS (READ ONLY)
    ========================= */
    match /reports/{id} {

      allow read: if isSignedIn();

      allow write: if isAdmin();
    }

    /* =========================
       DASHBOARD STATS
    ========================= */
    match /stats/{id} {

      allow read: if isSignedIn();

      allow write: if isAdmin();
    }

    /* =========================
       AUDIT LOG (VERY IMPORTANT)
    ========================= */
    match /auditLogs/{id} {

      allow read: if isAdmin() || isAuditor();

      allow create: if isAdmin() || isTeller();

      allow update: if false;

      allow delete: if isAdmin();
    }
  }
}
