rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    /* =========================
       AUTH CHECK
    ========================= */
    function isLoggedIn() {
      return request.auth != null;
    }

    /* =========================
       GET USER ROLE
    ========================= */
    function getRole() {

      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role;
    }

    /* =========================
       ROLE CHECKS
    ========================= */
    function isAdmin() {
      return isLoggedIn() &&
             getRole() == "ADMIN";
    }

    function isCashier() {
      return isLoggedIn() &&
             getRole() == "CASHIER";
    }

    function isViewer() {
      return isLoggedIn() &&
             getRole() == "VIEWER";
    }

    /* =========================
       MEMBERS
    ========================= */
    match /members/{memberId} {

      allow read:
        if isAdmin() ||
           isCashier() ||
           isViewer();

      allow create, update:
        if isAdmin() ||
           isCashier();

      allow delete:
        if isAdmin();
    }

    /* =========================
       SAVINGS
    ========================= */
    match /savings/{savingId} {

      allow read:
        if isAdmin() ||
           isCashier() ||
           isViewer();

      allow create:
        if isAdmin() ||
           isCashier();

      allow update:
        if false;

      allow delete:
        if isAdmin();
    }

    /* =========================
       LOANS
    ========================= */
    match /loans/{loanId} {

      allow read:
        if isAdmin() ||
           isCashier() ||
           isViewer();

      allow create:
        if isAdmin() ||
           isCashier();

      allow update:
        if isAdmin() ||
           isCashier();

      allow delete:
        if isAdmin();
    }

    /* =========================
       TRANSACTIONS
    ========================= */
    match /transactions/{transactionId} {

      allow read:
        if isAdmin() ||
           isCashier() ||
           isViewer();

      allow create:
        if isAdmin() ||
           isCashier();

      /* NEVER EDIT TRANSACTIONS */
      allow update:
        if false;

      allow delete:
        if isAdmin();
    }

    /* =========================
       REPORTS
    ========================= */
    match /reports/{reportId} {

      allow read:
        if isAdmin() ||
           isCashier() ||
           isViewer();

      allow write:
        if isAdmin();
    }

    /* =========================
       USERS
    ========================= */
    match /users/{userId} {

      allow read:
        if isAdmin();

      allow create:
        if isAdmin();

      allow update:
        if isAdmin();

      allow delete:
        if isAdmin();
    }

    /* =========================
       SETTINGS
    ========================= */
    match /settings/{settingId} {

      allow read:
        if isAdmin();

      allow write:
        if isAdmin();
    }

    /* =========================
       BLOCK EVERYTHING ELSE
    ========================= */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
