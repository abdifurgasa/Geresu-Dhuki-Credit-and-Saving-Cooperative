rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    /* =========================
       AUTH CHECK
    ========================= */
    function signedIn() {
      return request.auth != null;
    }

    /* =========================
       SAFE ROLE GETTER
       (NO CRASH if doc missing)
    ========================= */
    function getRole() {

      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role;
    }

    function isAdmin() {
      return signedIn() && getRole() == "admin";
    }

    function isTeller() {
      return signedIn() && getRole() == "teller";
    }

    function isAuditor() {
      return signedIn() && getRole() == "auditor";
    }

    /* =========================
       USERS (ADMIN ONLY)
    ========================= */
    match /users/{id} {

      allow read: if signedIn();

      allow create: if isAdmin();

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    /* =========================
       MEMBERS
    ========================= */
    match /members/{id} {

      allow read: if signedIn();

      allow create: if isAdmin() || isTeller();

      allow update: if isAdmin() || isTeller();

      allow delete: if isAdmin();
    }

    /* =========================
       SAVINGS
    ========================= */
    match /savings/{id} {

      allow read: if signedIn();

      allow create: if isAdmin() || isTeller();

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    /* =========================
       LOANS
    ========================= */
    match /loans/{id} {

      allow read: if signedIn();

      allow create: if isAdmin();

      allow update: if isAdmin() || isTeller();

      allow delete: if isAdmin();
    }

    /* =========================
       TRANSACTIONS
    ========================= */
    match /transactions/{id} {

      allow read: if signedIn();

      allow create: if isAdmin() || isTeller();

      allow update: if false;

      allow delete: if isAdmin();
    }

    /* =========================
       REPORTS
    ========================= */
    match /reports/{id} {

      allow read: if signedIn();

      allow write: if isAdmin();
    }

    /* =========================
       DASHBOARD STATS
    ========================= */
    match /stats/{id} {

      allow read: if signedIn();

      allow write: if isAdmin();
    }
  }
}
